# cfst tool and its data files (fetch from the upstream project yourself)
/cfst/

# Build artifacts
/cforward
/cfstnat

# Runtime state (local config, pool, logs)
/pool.json
/config.json
*.log

# Android app build outputs & bundled binaries (regenerated by android/build-apk.sh)
/android/.gradle/
/android/build/
/android/local.properties
/android/app/build/
/android/app/src/main/assets/bin/
/android/app/src/main/assets/cfst/
